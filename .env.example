# Обязательный секрет. Замените перед первым запуском.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Обязательные production bindings Telegram. Development Compose их не читает.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_BOT_USERNAME=replace_with_bot_username
# short_name игры из @BotFather /newgame.
TELEGRAM_GAME_SHORT_NAME=replace_with_game_short_name
# Публичный базовый URL игры (HTTPS).
GAME_PUBLIC_URL=https://cowskate.apps.botops.ru
# Секрет заголовка X-Telegram-Bot-Api-Secret-Token для /telegram/webhook:
# 16-256 символов A-Z a-z 0-9 _ -. Передаётся в setWebhook как secret_token.
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret
# Секрет подписи игровых сессий (URL-токен ?s=): длинная случайная строка.
GAME_SESSION_SECRET=replace-with-session-secret
